  <script>
    (()=>{
      let scene,camera,renderer,model,artworkTexture,controls;
      const container=document.getElementById('popupScene3D');
      const fallbackScene=document.getElementById('popupScene');
      if(!container){
        console.error('popupScene3D container not found');
        if(fallbackScene)fallbackScene.hidden=false;
        return;
      }
      
      function showFallback(){
        container.style.display='none';
        if(fallbackScene)fallbackScene.hidden=false;
      }
      
      function loadModel(withTable){
        if(model){
          scene.remove(model);
          model=null;
        }
        
        const objFile=withTable?'./new_scene111_0.obj':'./new_scene_0.obj';
        const mtlFile=withTable?'./new_scene111.mtl':'./new_scene.mtl';
        
        console.log('Loading model:',objFile);
        
        if(typeof THREE.OBJLoader!=='undefined'){
          const mtlLoader=new THREE.MTLLoader();
          mtlLoader.load(mtlFile,function(materials){
            materials.preload();
            const objLoader=new THREE.OBJLoader();
            objLoader.setMaterials(materials);
            objLoader.load(objFile,function(object){
              model=object;
              
              const box=new THREE.Box3().setFromObject(model);
              const center=box.getCenter(new THREE.Vector3());
              const size=box.getSize(new THREE.Vector3());
              
              console.log('Model size:',size);
              console.log('Model center:',center);
              
              model.position.sub(center);
              model.position.y=0;
              
              const maxDim=Math.max(size.x,size.y,size.z);
              const scale=withTable?20/maxDim:2/maxDim;
              model.scale.set(scale,scale,scale);
              
              scene.add(model);
              
              model.traverse(function(child){
                if(child.isMesh){
                  console.log('Mesh found:',child.name);
                  if(child.geometry && child.geometry.attributes.uv){
                    console.log('Mesh has UVs, count:',child.geometry.attributes.uv.count);
                  }else{
                    console.warn('Mesh does NOT have UVs');
                  }
                  if(child.material){
                    console.log('Material type:',child.material.type);
                  }
                }
              });
              
              if(artworkTexture){
                applyArtwork(artworkTexture.image?artworkTexture.image.src:null);
              }
            },function(xhr){
              console.log('Loading progress:',(xhr.loaded/xhr.total*100)+'%');
            },function(error){
              console.error('Error loading OBJ model:',error);
            });
          },undefined,function(error){
            console.error('Error loading MTL:',error);
            const objLoader=new THREE.OBJLoader();
            objLoader.load(objFile,function(object){
              model=object;
              const box=new THREE.Box3().setFromObject(model);
              const center=box.getCenter(new THREE.Vector3());
              const size=box.getSize(new THREE.Vector3());
              console.log('Model size (no MTL):',size);
              model.position.sub(center);
              model.position.y=0;
              const maxDim=Math.max(size.x,size.y,size.z);
              const scale=withTable?20/maxDim:15/maxDim;
              model.scale.set(scale,scale,scale);
              scene.add(model);
              if(artworkTexture){
                applyArtwork(artworkTexture.image?artworkTexture.image.src:null);
              }
            },undefined,function(error){
              console.error('Error loading OBJ without MTL:',error);
            });
          });
        }
      }
      
      function init3D(){
        try{
          if(typeof THREE==='undefined'){
            console.error('Three.js not loaded');
            showFallback();
            return;
          }
          
          scene=new THREE.Scene();
          scene.background=new THREE.Color(0xeef0f5);
          
          const width=container.clientWidth||400;
          const height=container.clientHeight||400;
          camera=new THREE.PerspectiveCamera(45,width/height,0.1,1000);
          camera.position.set(0,2,5);
          camera.lookAt(0,0,0);
          
          renderer=new THREE.WebGLRenderer({antialias:true});
          renderer.setSize(width,height);
          renderer.setPixelRatio(window.devicePixelRatio);
          container.innerHTML='';
          container.appendChild(renderer.domElement);
          
          const ambientLight=new THREE.AmbientLight(0xffffff,0.6);
          scene.add(ambientLight);
          
          const directionalLight=new THREE.DirectionalLight(0xffffff,0.8);
          directionalLight.position.set(5,10,7);
          scene.add(directionalLight);
          
          const withTableCheckbox=document.getElementById('popupWithTable');
          console.log('Checkbox found:',withTableCheckbox);
          const initialWithTable=withTableCheckbox?withTableCheckbox.checked:false;
          console.log('Initial withTable:',initialWithTable);
          
          setTimeout(function(){
            loadModel(initialWithTable);
            
            if(typeof THREE.OrbitControls!=='undefined'){
              controls=new THREE.OrbitControls(camera,renderer.domElement);
              controls.enableDamping=true;
              controls.dampingFactor=0.05;
              controls.autoRotate=true;
              controls.autoRotateSpeed=1;
            }
            
            camera.position.set(0,1,5);
            camera.lookAt(0,1,0);
            
            animate();
          },500);
          
          if(withTableCheckbox){
            withTableCheckbox.addEventListener('change',function(){
              console.log('Checkbox changed, checked:',this.checked);
              loadModel(this.checked);
            });
          }
          
          window.addEventListener('resize',onWindowResize);
        }catch(e){
          console.error('Error initializing 3D scene:',e);
          showFallback();
        }
      }
      
      function onWindowResize(){
        if(!camera||!renderer||!container)return;
        const width=container.clientWidth;
        const height=container.clientHeight;
        camera.aspect=width/height;
        camera.updateProjectionMatrix();
        renderer.setSize(width,height);
      }
      
      function animate(){
        requestAnimationFrame(animate);
        if(controls){
          controls.update();
        }
        renderer.render(scene,camera);
      }
      
      function applyArtwork(imageUrl){
        if(!model){
          console.warn('Model not loaded yet');
          return;
        }
        const textureLoader=new THREE.TextureLoader();
        textureLoader.load(imageUrl,function(texture){
          texture.wrapS=THREE.ClampToEdgeWrapping;
          texture.wrapT=THREE.ClampToEdgeWrapping;
          texture.minFilter=THREE.LinearFilter;
          texture.magFilter=THREE.LinearFilter;
          artworkTexture=texture;
          
          console.log('Texture loaded, applying to meshes');
          let meshCount=0;
          model.traverse(function(child){
            if(child.isMesh){
              meshCount++;
              if(child.material){
                if(Array.isArray(child.material)){
                  child.material.forEach(mat=>{
                    mat.map=texture;
                    mat.needsUpdate=true;
                  });
                }else{
                  child.material.map=texture;
                  child.material.needsUpdate=true;
                }
                console.log('Applied texture to mesh:',child.name||'unnamed');
              }else{
                console.warn('Mesh has no material:',child.name||'unnamed');
              }
            }
          });
          console.log('Total meshes processed:',meshCount);
        },undefined,function(error){
          console.error('Error loading texture:',error);
        });
      }
      
      if(document.readyState==='loading'){
        document.addEventListener('DOMContentLoaded',init3D);
      }else{
        init3D();
      }
      
      const form=document.getElementById('popupForm');
      if(form){
        const artworkInput=form.elements.namedItem('artwork');
        if(artworkInput){
          artworkInput.addEventListener('change',function(){
            const file=this.files[0];
            if(file&&file.type.startsWith('image/')){
              const url=URL.createObjectURL(file);
              applyArtwork(url);
            }
          });
        }
      }
      
      const enlargeButton=document.getElementById('popupEnlarge');
      const enlargeDialog=document.getElementById('popupEnlargeDialog');
      const enlargeClose=document.getElementById('popupEnlargeClose');
      const enlargeContainer=document.getElementById('popupEnlargeScene3D');
      
      if(enlargeButton&&enlargeDialog&&enlargeContainer){
        let enlargeScene,enlargeCamera,enlargeRenderer,enlargeModel,enlargeControls;
        
        function initEnlarge3D(){
          if(!enlargeContainer)return;
          
          try{
            enlargeScene=new THREE.Scene();
            enlargeScene.background=new THREE.Color(0xeef0f5);
            
            const width=enlargeContainer.clientWidth||800;
            const height=enlargeContainer.clientHeight||600;
            enlargeCamera=new THREE.PerspectiveCamera(45,width/height,0.1,1000);
            enlargeCamera.position.set(0,2,5);
            enlargeCamera.lookAt(0,0,0);
            
            enlargeRenderer=new THREE.WebGLRenderer({antialias:true});
            enlargeRenderer.setSize(width,height);
            enlargeRenderer.setPixelRatio(window.devicePixelRatio);
            enlargeContainer.innerHTML='';
            enlargeContainer.appendChild(enlargeRenderer.domElement);
            
            const ambientLight=new THREE.AmbientLight(0xffffff,0.6);
            enlargeScene.add(ambientLight);
            
            const directionalLight=new THREE.DirectionalLight(0xffffff,0.8);
            directionalLight.position.set(5,10,7);
            enlargeScene.add(directionalLight);
            
            const withTableCheckbox=document.getElementById('popupWithTable');
            const withTable=withTableCheckbox?withTableCheckbox.checked:false;
            const objFile=withTable?'./new_scene111_0.obj':'./new_scene_0.obj';
            const mtlFile=withTable?'./new_scene111.mtl':'./new_scene.mtl';
            
            if(typeof THREE.OBJLoader!=='undefined'){
              const mtlLoader=new THREE.MTLLoader();
              mtlLoader.load(mtlFile,function(materials){
                materials.preload();
                const objLoader=new THREE.OBJLoader();
                objLoader.setMaterials(materials);
                objLoader.load(objFile,function(object){
                  enlargeModel=object;
                  
                  const box=new THREE.Box3().setFromObject(enlargeModel);
                  const center=box.getCenter(new THREE.Vector3());
                  const size=box.getSize(new THREE.Vector3());
                  
                  enlargeModel.position.sub(center);
                  enlargeModel.position.y=0;
                  
                  const maxDim=Math.max(size.x,size.y,size.z);
                  const scale=withTable?20/maxDim:15/maxDim;
                  enlargeModel.scale.set(scale,scale,scale);
                  
                  enlargeScene.add(enlargeModel);
                  
                  if(artworkTexture){
                    enlargeModel.traverse(function(child){
                      if(child.isMesh&&child.material){
                        child.material.map=artworkTexture;
                        child.material.needsUpdate=true;
                      }
                    });
                  }
                  
                  if(typeof THREE.OrbitControls!=='undefined'){
                    enlargeControls=new THREE.OrbitControls(enlargeCamera,enlargeRenderer.domElement);
                    enlargeControls.enableDamping=true;
                    enlargeControls.dampingFactor=0.05;
                    enlargeControls.autoRotate=true;
                    enlargeControls.autoRotateSpeed=1;
                  }
                  
                  function animateEnlarge(){
                    requestAnimationFrame(animateEnlarge);
                    if(enlargeControls){
                      enlargeControls.update();
                    }
                    enlargeRenderer.render(enlargeScene,enlargeCamera);
                  }
                  animateEnlarge();
                });
              });
            }
          }catch(e){
            console.error('Error initializing enlarge 3D:',e);
          }
        }
        
        enlargeButton.addEventListener('click',function(){
          enlargeDialog.showModal();
          setTimeout(initEnlarge3D,100);
        });
        
        enlargeClose.addEventListener('click',function(){
          enlargeDialog.close();
        });
      }
      
      window.popup3D={applyArtwork};
    })();
  </script>


