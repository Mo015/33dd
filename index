    items.addEventListener('change',e=>{const id=e.target.dataset.id||e.target.dataset.qty;if(!id)return;if(e.target.type==='checkbox')state[id].on=e.target.checked;else state[id].qty=Math.max(1,Number(e.target.value)||1);render(true)});render();
